<UserControl x:Class="SaroHub.Desktop.Views.DayCloseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:BoolToVisibility      x:Key="BoolVis"/>
        <cv:InverseBoolToVisibility x:Key="InvBoolVis"/>
        <cv:StringToVisibility    x:Key="StrVis"/>
    </UserControl.Resources>
    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="520"
                Style="{StaticResource Card}" Padding="32 28">
            <StackPanel>

                <TextBlock Text="Close Day" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0 0 0 4"/>
                <TextBlock Text="{Binding OpenedAt, StringFormat='Opened: {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0 0 0 24"/>

                <!-- Summary grid -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Opening Cash" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="0" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding OpeningCash}"  Grid.Row="0" Grid.Column="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Cash Sales"   Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="1" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding CashSales}"    Grid.Row="1" Grid.Column="1" Margin="0 0 0 8" Foreground="{StaticResource SuccessBrush}"/>

                    <TextBlock Text="Khata Sales"  Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="2" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding CreditSales}"  Grid.Row="2" Grid.Column="1" Margin="0 0 0 8"/>

                    <TextBlock Text="Payments Received" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="3" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding KhataReceipts}" Grid.Row="3" Grid.Column="1" Margin="0 0 0 8" Foreground="{StaticResource SuccessBrush}"/>

                    <TextBlock Text="Cash Expenses" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="4" Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding CashExpenses}" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource DangerBrush}" Margin="0 0 0 8"/>

                    <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0 4"/>

                    <TextBlock Text="Expected Cash" FontWeight="Bold" Grid.Row="6"/>
                    <TextBlock Text="{Binding ExpectedCash}" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PrimaryBrush}" Grid.Row="6" Grid.Column="1"/>
                </Grid>

                <!-- Count + close -->
                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="16 14" Margin="0 20 0 0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Count the cash and enter the actual amount:"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 8"/>
                            <TextBox Text="{Binding CountedCash, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Difference" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                            <TextBlock Text="{Binding DifferenceFormatted}" FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Note (optional)" Style="{StaticResource Caption}" Margin="0 12 0 4"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="36"/>

                <!-- Error -->
                <Border Style="{StaticResource ToastError}" Margin="0 10 0 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
                </Border>

                <!-- Closed success -->
                <Border Background="#E6F4EC" CornerRadius="8" Padding="16 12" Margin="0 12 0 0"
                        Visibility="{Binding IsClosed, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="✓ Day closed successfully. Have a great evening!"
                               Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Close button -->
                <Button Content="⊗  Close Day"
                        Style="{StaticResource DangerButton}"
                        Height="46" FontSize="15" Margin="0 20 0 0"
                        Command="{Binding CloseCommand}"
                        Visibility="{Binding IsClosed, Converter={StaticResource InvBoolVis}}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
