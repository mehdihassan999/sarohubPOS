<UserControl x:Class="SaroHub.Desktop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter     x:Key="Money"/>
        <cv:QtyConverter       x:Key="Qty"/>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Stock" Style="{StaticResource H2}" Margin="0 0 0 8"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Adjust Stock" Style="{StaticResource SecondaryButton}" Margin="0 0 8 0" Command="{Binding AdjustCommand}"/>
                    <Button Content="↻ Refresh"    Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Adjust panel -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 12"
                Visibility="{Binding ShowAdjust, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding AdjQty, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="36"/>
                <ComboBox ItemsSource="{Binding AdjTypes}" SelectedItem="{Binding AdjType}" Grid.Column="2" Height="36"/>
                <TextBox Text="{Binding AdjReason, UpdateSourceTrigger=PropertyChanged}" Grid.Column="4" Height="36"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="Save"   Style="{StaticResource SuccessButton}"   Margin="0 0 8 0" Command="{Binding ConfirmAdjCommand}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelAdjCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product"   Binding="{Binding Name}"     Width="*"/>
                    <DataGridTextColumn Header="SKU"       Binding="{Binding Sku}"       Width="90"/>
                    <DataGridTextColumn Header="Stock"     Binding="{Binding StockQtyRaw, Converter={StaticResource Qty}}" Width="80"/>
                    <DataGridTextColumn Header="Min"       Binding="{Binding MinStockQtyRaw, Converter={StaticResource Qty}}" Width="70"/>
                    <DataGridTextColumn Header="Unit"      Binding="{Binding UnitSymbol}" Width="55"/>
                    <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePricePaisa, Converter={StaticResource Money}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
