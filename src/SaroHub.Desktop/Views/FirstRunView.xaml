<Window x:Class="SaroHub.Desktop.Views.FirstRunView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
        Title="SaroHub POS — First Time Setup"
        Height="560" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </Window.Resources>

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="460" Style="{StaticResource Card}" Padding="40 36">
            <StackPanel>

                <!-- Header -->
                <TextBlock Text="SaroHub POS" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome! Let's set up your shop."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0 4 0 4"/>
                <TextBlock Text="{Binding StepLabel}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" Margin="0 0 0 24"
                           Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>

                <!-- Step 1 — Shop Name -->
                <StackPanel Visibility="{Binding Step, Converter={x:Static cv:BoolToVisibility.Instance}}">
                    <!-- visibility switched inline via converter trick isn't ideal; use code-behind or DataTriggers -->
                </StackPanel>

                <!-- Steps are shown via DataTriggers on the outer border -->
                <Grid x:Name="StepsPanel">

                    <!-- Step 1 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Shop Name" Style="{StaticResource H3}" Margin="0 0 0 8"/>
                        <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 12"/>
                        <TextBlock Text="Owner Name" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 12"/>
                        <TextBlock Text="Phone" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 12"/>
                        <TextBlock Text="Address" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Step 2 — Shop type, currency, language -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Shop Type" Style="{StaticResource H3}" Margin="0 0 0 8"/>
                        <ComboBox ItemsSource="{Binding ShopTypes}"
                                  SelectedItem="{Binding ShopType}" Margin="0 0 0 16"/>
                        <TextBlock Text="Currency" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16"/>
                        <TextBlock Text="Language" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                    </StackPanel>

                    <!-- Step 3 — Admin account -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Owner Login" Style="{StaticResource H3}" Margin="0 0 0 8"/>
                        <TextBlock Text="Username" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 12"/>
                        <TextBlock Text="Password (min 4 characters)" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <PasswordBox x:Name="PwBox" PasswordChanged="PwBox_Changed" Margin="0 0 0 12"/>
                        <TextBlock Text="Quick PIN (optional)" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Step 4 — Opening cash -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Opening Cash" Style="{StaticResource H3}" Margin="0 0 0 8"/>
                        <TextBlock Text="How much cash is in the till right now? (Enter 0 if none)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0 0 0 16"/>
                        <TextBox Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Step 5 — Backup folder -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="5">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Backup Folder" Style="{StaticResource H3}" Margin="0 0 0 8"/>
                        <TextBlock Text="Where should automatic backups be saved?"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0 0 0 16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupFolder}" IsReadOnly="True" Grid.Column="0"/>
                            <Button Content="Browse" Grid.Column="1" Margin="8 0 0 0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step 6 — Summary -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="6">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Ready to Start!" Style="{StaticResource H2}"
                                   HorizontalAlignment="Center" Margin="0 0 0 16"/>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Shop:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="0"/>
                            <TextBlock Text="{Binding ShopName}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Text="Type:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="1"/>
                            <TextBlock Text="{Binding ShopType}" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Text="Currency:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="2"/>
                            <TextBlock Text="{Binding Currency}" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Text="Username:" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="3"/>
                            <TextBlock Text="{Binding Username}" Grid.Row="3" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="Click Finish to save and open the application."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0 16 0 0"/>
                    </StackPanel>

                </Grid>

                <!-- Error -->
                <Border Style="{StaticResource ToastError}" Margin="0 12 0 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Nav buttons -->
                <Grid Margin="0 24 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="← Back" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackCommand}"/>

                    <!-- Next (steps 1–5) -->
                    <Button Content="Next →" Grid.Column="2" Command="{Binding NextCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="6">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Finish (step 6) -->
                    <!-- Finish (step 6) -->
                    <Button Content="✓ Finish" Grid.Column="2"
                            Command="{Binding FinishCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="6">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
