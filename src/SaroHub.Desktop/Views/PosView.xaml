<UserControl x:Class="SaroHub.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <cv:MoneyConverter         x:Key="Money"/>
        <cv:QtyConverter           x:Key="Qty"/>
        <cv:BoolToVisibility       x:Key="BoolVis"/>
        <cv:StringToVisibility     x:Key="StrVis"/>
        <cv:InverseBoolToVisibility x:Key="InvBoolVis"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding ChargeCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ClearBillCommand}"/>
        <KeyBinding Key="F9" Command="{Binding QuickCashCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>    <!-- product search -->
            <ColumnDefinition Width="340"/>  <!-- bill panel -->
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT — Product Search ════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="16 12 8 12">

            <!-- Search bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12 10" Margin="0 0 0 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="0"
                             Height="38"
                             KeyDown="SearchBox_KeyDown"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍  Search product, barcode, SKU…"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="10 0" VerticalAlignment="Center"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Product list -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ProductList"
                          ItemsSource="{Binding SearchResults}"
                          MouseDoubleClick="ProductGrid_DoubleClick"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product"   Binding="{Binding Name}"      Width="*"/>
                        <DataGridTextColumn Header="Brand"     Binding="{Binding BrandName}"  Width="100"/>
                        <DataGridTextColumn Header="SKU"       Binding="{Binding Sku}"        Width="90"/>
                        <DataGridTextColumn Header="Price"     Binding="{Binding SalePricePaisa, Converter={StaticResource Money}}" Width="100"/>
                        <DataGridTextColumn Header="Stock"     Binding="{Binding StockQtyRaw, Converter={StaticResource Qty}}" Width="70"/>
                        <DataGridTextColumn Header="Unit"      Binding="{Binding UnitSymbol}" Width="50"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <EventSetter Event="MouseLeftButtonDown" Handler="ProductGrid_DoubleClick"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

        </DockPanel>

        <!-- ══ RIGHT — Bill Panel ════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="White" Margin="0 0 0 0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1 0 0 0">
            <DockPanel>

                <!-- Bill header -->
                <Border DockPanel.Dock="Top" Padding="16 14"
                        Background="{StaticResource PrimaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="New Sale" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding CustomerName}" Foreground="#BCD4E8" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear  F5"
                                Style="{StaticResource GhostButton}"
                                Foreground="White"
                                Command="{Binding ClearBillCommand}"/>
                    </Grid>
                </Border>

                <!-- Success toast -->
                <Border DockPanel.Dock="Top"
                        Background="#E6F4EC" Padding="14 8"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LastInvoice, StringFormat='✓ Sale saved: {0}'}"
                               Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                </Border>

                <!-- Error -->
                <Border DockPanel.Dock="Top" Style="{StaticResource ToastError}" Margin="8 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Bill lines -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              MaxHeight="320">
                    <ItemsControl ItemsSource="{Binding BillLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0 0 0 1" Padding="10 8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="✕"
                                                    Style="{StaticResource GhostButton}" FontSize="11"
                                                    Command="{Binding DataContext.RemoveLineCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{StaticResource DangerBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0 4 0 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="−" Grid.Column="0" Width="28" Height="26"
                                                    Style="{StaticResource SecondaryButton}" Padding="0"
                                                    Command="{Binding DataContext.DecrQtyCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Qty}"
                                                       Width="36" TextAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="+" Grid.Column="2" Width="28" Height="26"
                                                    Style="{StaticResource PrimaryButton}" Padding="0"
                                                    Command="{Binding DataContext.IncrQtyCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UnitPriceFormatted}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="8 0 0 0" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotalFormatted}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Totals -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0 1 0 0" Padding="16 12">
                    <StackPanel>

                        <Grid Margin="0 0 0 4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SubtotalFormatted}"/>
                        </Grid>
                        <Grid Margin="0 0 0 4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Discount" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiscountsFormatted}" Foreground="{StaticResource DangerBrush}"/>
                        </Grid>
                        <Separator Margin="0 4"/>
                        <Grid Margin="0 0 0 10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalFormatted}"
                                       FontWeight="Bold" FontSize="18"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Payment inputs -->
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cash" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="CashBox" Grid.Column="1"
                                     Text="{Binding CashTendered, Converter={StaticResource Money}, ConverterParameter=noprefix}"
                                     LostFocus="CashBox_LostFocus" Height="32"/>
                            <Button Grid.Column="2" Content="Exact" Margin="4 0 0 0"
                                    Style="{StaticResource SecondaryButton}" Height="32" Padding="8 0"
                                    Command="{Binding QuickCashCommand}"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khata" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="KhataBox" Grid.Column="1"
                                     LostFocus="KhataBox_LostFocus" Height="32"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Bank" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="BankBox" Grid.Column="1"
                                     LostFocus="BankBox_LostFocus" Height="32"/>
                        </Grid>

                        <Grid Margin="0 4 0 10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Change" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChangeFormatted}"
                                       FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="15"/>
                        </Grid>

                        <!-- Charge button -->
                        <Button Content="⚡  Charge  F4"
                                Style="{StaticResource PrimaryButton}"
                                Height="46" FontSize="15"
                                Command="{Binding ChargeCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>

                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
