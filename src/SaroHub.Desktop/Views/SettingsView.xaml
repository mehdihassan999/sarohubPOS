<UserControl x:Class="SaroHub.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:StringToVisibility x:Key="StrVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Settings" Style="{StaticResource H2}"/>
                <Button Grid.Column="1" Content="Save Settings" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToastError}" Margin="0 0 0 10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
        </Border>

        <ScrollViewer>
            <StackPanel>

                <!-- Shop -->
                <Border Style="{StaticResource Card}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Shop" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Shop Name *" Style="{StaticResource Caption}" Grid.Row="0"/>
                            <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 4 0 12" Grid.Row="1"/>

                            <TextBlock Text="Phone" Style="{StaticResource Caption}" Grid.Column="2" Grid.Row="0"/>
                            <TextBox Text="{Binding ShopPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 4 0 12" Grid.Column="2" Grid.Row="1"/>

                            <TextBlock Text="Owner Name" Style="{StaticResource Caption}" Grid.Row="2"/>
                            <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 4 0 12" Grid.Row="3"/>

                            <TextBlock Text="Address" Style="{StaticResource Caption}" Grid.Column="2" Grid.Row="2"/>
                            <TextBox Text="{Binding ShopAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 4 0 12" Grid.Column="2" Grid.Row="3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- App -->
                <Border Style="{StaticResource Card}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Application" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Currency" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Language" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Receipt -->
                <Border Style="{StaticResource Card}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Receipt" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                        <TextBlock Text="Receipt Footer" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                 Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="10 8"/>
                    </StackPanel>
                </Border>

                <!-- Stock -->
                <Border Style="{StaticResource Card}" Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Stock" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                        <CheckBox Content="Allow negative stock (sell even when stock is zero)"
                                  IsChecked="{Binding AllowNegativeStock}"/>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Auto Backup" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Backup Folder" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding BackupFolder}" IsReadOnly="True"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Bottom" Command="{Binding BrowseFolderCommand}" Margin="0"/>
                        </Grid>
                        <StackPanel Margin="0 12 0 0">
                            <TextBlock Text="Auto Backup Frequency (hours)" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding BackupFreqHours, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
