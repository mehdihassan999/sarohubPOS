<UserControl x:Class="SaroHub.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter x:Key="Money"/>
        <cv:QtyConverter   x:Key="Qty"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Products" Style="{StaticResource H2}" Margin="0 0 0 8"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" HorizontalAlignment="Left" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Edit"     Style="{StaticResource SecondaryButton}" Margin="0 0 8 0"
                            Command="{Binding EditCommand}"/>
                    <Button Content="+ New Product" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*"/>
                    <DataGridTextColumn Header="SKU"      Binding="{Binding Sku}"      Width="100"/>
                    <DataGridTextColumn Header="Brand"    Binding="{Binding BrandName}" Width="120"/>
                    <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePricePaisa, Converter={StaticResource Money}}" Width="110"/>
                    <DataGridTextColumn Header="Stock"    Binding="{Binding StockQtyRaw, Converter={StaticResource Qty}}" Width="80"/>
                    <DataGridTextColumn Header="Unit"     Binding="{Binding UnitSymbol}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
