<UserControl x:Class="SaroHub.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter     x:Key="Money"/>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Customers" Style="{StaticResource H2}" Margin="0 0 0 8"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Edit"    Style="{StaticResource SecondaryButton}" Margin="0 0 8 0" Command="{Binding EditCommand}"/>
                    <Button Content="+ New"   Style="{StaticResource PrimaryButton}"   Command="{Binding NewCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edit panel -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 12"
                Visibility="{Binding ShowEdit, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Name *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Phone" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Address" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <Border.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Border.InputBindings>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToastError}" Margin="0 0 0 12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="16 0 0 0"
                            Visibility="{Binding ShowEdit, Converter={StaticResource BoolVis}}">
                    <Button Content="Save"   Style="{StaticResource SuccessButton}"   Command="{Binding SaveCommand}" Margin="0 0 8 0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Visibility="{Binding ShowEdit, Converter={StaticResource BoolVis}}"
                Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save"   Style="{StaticResource SuccessButton}"   Command="{Binding SaveCommand}" Margin="0 0 8 0"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"    Width="*"/>
                    <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"   Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding BalancePaisa, Converter={StaticResource Money}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
