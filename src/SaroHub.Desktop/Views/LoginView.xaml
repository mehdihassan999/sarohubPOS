<Window x:Class="SaroHub.Desktop.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
        Title="SaroHub POS — Login"
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <cv:BoolToVisibility  x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </Window.Resources>

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="360" Style="{StaticResource Card}" Padding="36 40">
            <StackPanel>

                <!-- Logo / Brand -->
                <TextBlock Text="SaroHub POS" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Point of Sale System" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0 4 0 32"/>

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 16"/>

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                <PasswordBox x:Name="PwBox" Margin="0 0 0 6"
                             KeyDown="PwBox_KeyDown"/>

                <!-- Error -->
                <Border Style="{StaticResource ToastError}" Margin="0 8 0 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Login button -->
                <Button Content="Login" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Height="42" Margin="0 20 0 0"
                        Click="LoginBtn_Click"/>

                <!-- Busy -->
                <TextBlock Text="Signing in…" HorizontalAlignment="Center" Margin="0 10 0 0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
