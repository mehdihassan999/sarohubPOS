<UserControl x:Class="SaroHub.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
        <cv:DateTimeConverter  x:Key="DT"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 14" Margin="0 0 0 16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Backup" Style="{StaticResource H2}" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Last Backup:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 8 0"/>
                        <TextBlock Text="{Binding LastBackupInfo}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                        <TextBlock Text="Folder:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 8 0"/>
                        <TextBlock Text="{Binding BackupFolder}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻" Style="{StaticResource SecondaryButton}" Width="36"
                            Command="{Binding RefreshCommand}" Margin="0 0 8 0" ToolTip="Refresh"/>
                    <Button Content="Open Folder"    Style="{StaticResource SecondaryButton}" Margin="0 0 8 0"
                            Command="{Binding OpenFolderCommand}"/>
                    <Button Content="Restore"         Style="{StaticResource SecondaryButton}" Margin="0 0 8 0"
                            Command="{Binding RestoreCommand}"/>
                    <Button Content="Backup to USB"   Style="{StaticResource SecondaryButton}" Margin="0 0 8 0"
                            Command="{Binding BackupToUsbCommand}"/>
                    <Button Content="Backup Now"      Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackupNowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToastError}" Margin="0 0 0 10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryLightBrush}"
                CornerRadius="6" Padding="14 10" Margin="0 0 0 12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Working… please wait." Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16 12">
                    <TextBlock Text="Backup History" Style="{StaticResource H3}"/>
                </Border>
                <DataGrid ItemsSource="{Binding History}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"     Binding="{Binding AtUtc, Converter={StaticResource DT}}" Width="150"/>
                        <DataGridTextColumn Header="File"     Binding="{Binding FilePath}" Width="*"/>
                        <DataGridTextColumn Header="Size"     Binding="{Binding SizeBytes}" Width="100"/>
                        <DataGridCheckBoxColumn Header="OK"   Binding="{Binding Verified}"  Width="50"/>
                        <DataGridTextColumn Header="Note"     Binding="{Binding Note}"     Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
