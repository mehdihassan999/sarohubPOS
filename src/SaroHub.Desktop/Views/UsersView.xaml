<UserControl x:Class="SaroHub.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Users" Style="{StaticResource H2}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Edit"  Style="{StaticResource SecondaryButton}" Margin="0 0 8 0" Command="{Binding EditCommand}"/>
                    <Button Content="+ New" Style="{StaticResource PrimaryButton}"   Command="{Binding NewCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edit panel -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 12"
                Visibility="{Binding ShowEdit, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="User Details" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Full Name *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Username *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <PasswordBox x:Name="PwBox" PasswordChanged="PwBox_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Role *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" DisplayMemberPath="Name"/>
                    </StackPanel>
                </Grid>
                <CheckBox Content="Active" IsChecked="{Binding EditActive}" Margin="0 10 0 0"/>
                <Border Style="{StaticResource ToastError}" Margin="0 10 0 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                    <Button Content="Save"   Style="{StaticResource SuccessButton}"   Margin="0 0 8 0" Command="{Binding SaveCommand}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full Name"  Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Username"   Binding="{Binding Username}" Width="130"/>
                    <DataGridTextColumn Header="Role"       Binding="{Binding Role.Name}" Width="130"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}"  Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
