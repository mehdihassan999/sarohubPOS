<Window x:Class="SaroHub.Desktop.Views.ProductEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
        Title="{Binding Title}" Height="580" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <cv:StringToVisibility x:Key="StrVis"/>
    </Window.Resources>
    <Border Margin="24" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Name *" Style="{StaticResource Caption}" Grid.Row="0" Grid.ColumnSpan="2"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 4 0 10" Grid.Row="1" Grid.ColumnSpan="2"/>

                <TextBlock Text="SKU / Code" Style="{StaticResource Caption}" Grid.Row="2"/>
                <TextBlock Text="Barcode" Style="{StaticResource Caption}" Grid.Row="2" Grid.Column="1" Margin="8 0 0 0"/>
                <TextBox Text="{Binding Sku}" Margin="0 4 4 10" Grid.Row="3"/>
                <TextBox Text="{Binding Barcode}" Margin="8 4 0 10" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Brand" Style="{StaticResource Caption}" Grid.Row="4"/>
                <TextBlock Text="Category" Style="{StaticResource Caption}" Grid.Row="4" Grid.Column="1" Margin="8 0 0 0"/>
                <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Brand}"
                          DisplayMemberPath="Name" Margin="0 4 4 10" Grid.Row="5"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                          DisplayMemberPath="Name" Margin="8 4 0 10" Grid.Row="5" Grid.Column="1"/>

                <TextBlock Text="Unit *" Style="{StaticResource Caption}" Grid.Row="6"/>
                <TextBlock Text="Model" Style="{StaticResource Caption}" Grid.Row="6" Grid.Column="1" Margin="8 0 0 0"/>
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding BaseUnit}"
                          DisplayMemberPath="Name" Margin="0 4 4 10" Grid.Row="7"/>
                <TextBox Text="{Binding Model}" Margin="8 4 0 10" Grid.Row="7" Grid.Column="1"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sale Price" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding SalePrice}" Margin="0 4 4 0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Purchase Price" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding PurchasePrice}" Margin="2 4 4 0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Min Stock" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding MinStock}" Margin="4 4 0 0"/>
                </StackPanel>
            </Grid>

            <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0 12 0 0"/>
            <CheckBox Content="Track serial numbers" IsChecked="{Binding TracksSerial}" Margin="0 6 0 0"/>

            <TextBlock Text="Notes" Style="{StaticResource Caption}" Margin="0 12 0 4"/>
            <TextBox Text="{Binding Notes}" Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10 8"/>

            <Border Style="{StaticResource ToastError}" Margin="0 10 0 0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0 0 10 0"
                        Command="{Binding CancelCommand}" Click="CancelBtn_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
