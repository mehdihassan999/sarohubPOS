<UserControl x:Class="SaroHub.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter     x:Key="Money"/>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Suppliers" Style="{StaticResource H2}" Margin="0 0 0 8"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Height="36"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Pay Supplier" Style="{StaticResource SecondaryButton}" Margin="0 0 8 0" Command="{Binding PayCommand}"/>
                    <Button Content="Edit"         Style="{StaticResource SecondaryButton}" Margin="0 0 8 0" Command="{Binding EditCommand}"/>
                    <Button Content="+ New"        Style="{StaticResource PrimaryButton}"   Command="{Binding NewCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pay panel -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 12"
                Visibility="{Binding ShowPay, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Amount" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Method" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                    <ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding PayMethod}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Confirm" Style="{StaticResource SuccessButton}"   Margin="0 0 8 0" Command="{Binding ConfirmPayCommand}"/>
                    <Button Content="Cancel"  Style="{StaticResource SecondaryButton}" Command="{Binding CancelPayCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"    Width="*"/>
                    <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"   Width="130"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding BalancePaisa, Converter={StaticResource Money}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
