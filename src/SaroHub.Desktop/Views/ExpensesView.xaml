<UserControl x:Class="SaroHub.Desktop.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter     x:Key="Money"/>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
        <cv:DateTimeConverter  x:Key="DT"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Expenses" Style="{StaticResource H2}"/>
                <Button Grid.Column="1" Content="+ Add Expense" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}"/>
            </Grid>
        </Border>

        <!-- New expense panel -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 12"
                Visibility="{Binding ShowNew, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="New Expense" Style="{StaticResource H3}" Margin="0 0 0 12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Category *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Amount *" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Method" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding Method}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Note" Style="{StaticResource Caption}" Margin="0 0 0 4"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource ToastError}" Margin="0 8 0 0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                    <Button Content="Save"   Style="{StaticResource SuccessButton}"   Margin="0 0 8 0" Command="{Binding SaveCommand}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"     Binding="{Binding AtUtc, Converter={StaticResource DT}}" Width="140"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding ExpenseCategory.Name}" Width="160"/>
                    <DataGridTextColumn Header="Amount"   Binding="{Binding AmountPaisa, Converter={StaticResource Money}}" Width="120"/>
                    <DataGridTextColumn Header="Method"   Binding="{Binding Method}" Width="100"/>
                    <DataGridTextColumn Header="Note"     Binding="{Binding Note}"   Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
