<UserControl x:Class="SaroHub.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter x:Key="Money"/>
    </UserControl.Resources>
    <DockPanel Margin="16 12">
        <!-- Header + date range -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Reports" Style="{StaticResource H2}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="12 0 8 0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130"/>
                    <Button Content="↻" Style="{StaticResource SecondaryButton}" Margin="12 0 0 0"
                            Command="{Binding RefreshCommand}" Width="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl SelectedIndex="{Binding TabIndex}">

            <!-- P&L -->
            <TabItem Header="Profit &amp; Loss">
                <Border Style="{StaticResource Card}" Margin="0 12 0 0">
                    <Grid MaxWidth="500" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sales" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="0"/>
                        <TextBlock Text="{Binding SalesFmt}" FontWeight="SemiBold" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Text="Discount" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="1"/>
                        <TextBlock Text="{Binding DiscFmt}"  Grid.Row="1" Grid.Column="1" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="Cost of Goods" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="2"/>
                        <TextBlock Text="{Binding CogsFmt}"  Grid.Row="2" Grid.Column="1" Foreground="{StaticResource DangerBrush}"/>
                        <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0 6"/>
                        <TextBlock Text="Gross Profit" FontWeight="SemiBold" Grid.Row="4"/>
                        <TextBlock Text="{Binding GrossFmt}" FontWeight="SemiBold" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Expenses" Foreground="{StaticResource TextSecondaryBrush}" Grid.Row="5"/>
                        <TextBlock Text="{Binding ExpFmt}"  Grid.Row="5" Grid.Column="1" Foreground="{StaticResource DangerBrush}"/>
                        <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="0 6"/>
                        <TextBlock Text="NET PROFIT" FontWeight="Bold" FontSize="14" Grid.Row="7"/>
                        <TextBlock Text="{Binding NetFmt}" FontWeight="Bold" FontSize="15" Grid.Row="7" Grid.Column="1" Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Trial Balance -->
            <TabItem Header="Trial Balance">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0 12 0 0">
                    <DataGrid ItemsSource="{Binding TrialBalance}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"   Binding="{Binding Code}"   Width="80"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding Name}"  Width="*"/>
                            <DataGridTextColumn Header="Debit"  Binding="{Binding Debit}"  Width="130"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Khata -->
            <TabItem Header="Khata">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0 12 0 0">
                    <DataGrid ItemsSource="{Binding KhataReport}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Name}"    Width="*"/>
                            <DataGridTextColumn Header="Phone"    Binding="{Binding Phone}"   Width="120"/>
                            <DataGridTextColumn Header="Balance"  Binding="{Binding BalancePaisa, Converter={StaticResource Money}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
