<UserControl x:Class="SaroHub.Desktop.Views.KhataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:SaroHub.Desktop.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <cv:MoneyConverter     x:Key="Money"/>
        <cv:BoolToVisibility   x:Key="BoolVis"/>
        <cv:StringToVisibility x:Key="StrVis"/>
        <cv:DateTimeConverter  x:Key="DT"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Customer list -->
        <DockPanel Grid.Column="0" Margin="16 12 8 12">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12 10" Margin="0 0 0 10">
                <StackPanel>
                    <TextBlock Text="Khata" Style="{StaticResource H2}" Margin="0 0 0 8"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding Customers}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12 10" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0 0 0 1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Phone}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BalancePaisa, Converter={StaticResource Money}}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Ledger + payment -->
        <DockPanel Grid.Column="1" Margin="0 12 16 12">
            <!-- Header bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16 12" Margin="0 0 0 10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name, FallbackValue='Select a customer'}"
                                   Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding BalanceLabel}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Receive Payment"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReceiveCommand}"/>
                </Grid>
            </Border>

            <!-- Payment panel -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0 0 0 10"
                    Visibility="{Binding ShowPayment, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Receive Payment" Style="{StaticResource H3}" Margin="0 0 0 10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/><ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="0" Height="36"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding PayMethods}"
                                  SelectedItem="{Binding PayMethod}" Height="36"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="Confirm" Style="{StaticResource SuccessButton}"
                                    Command="{Binding ConfirmPayCommand}" Margin="0 0 8 0"/>
                            <Button Content="Cancel"  Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelPayCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource ToastError}" Margin="0 8 0 0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Ledger -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Ledger}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date"        Binding="{Binding AtLocal, Converter={StaticResource DT}}" Width="140"/>
                        <DataGridTextColumn Header="Document"    Binding="{Binding DocumentNo}"  Width="110"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Debit"       Binding="{Binding DebitPaisa,  Converter={StaticResource Money}}" Width="110"/>
                        <DataGridTextColumn Header="Credit"      Binding="{Binding CreditPaisa, Converter={StaticResource Money}}" Width="110"/>
                        <DataGridTextColumn Header="Balance"     Binding="{Binding RunningPaisa,Converter={StaticResource Money}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
